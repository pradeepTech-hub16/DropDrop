{
  "name": "dropdrop-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DropDrop REST API (Phase 2): Express + MongoDB Atlas",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 --test-timeout=60000 test/*.test.js",
    "test:atlas": "node --test --test-concurrency=1 test/atlas.smoke.test.js test/collab.atlas.test.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lib0": "^0.2.119",
    "mongoose": "^9.10.4",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "y-websocket": "^3.1.0"
  }
}

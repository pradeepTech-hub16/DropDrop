# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
# Template (replace <db_password> with your Atlas database-user password, URL-encoded if it has
# special characters; note the database name "dropdrop" before the "?"):
#   mongodb+srv://<user>:<db_password>@<cluster-host>/dropdrop?appName=Cluster0
MONGODB_URI=your_mongodb_atlas_connection_string
# Trusted website origin(s), comma-separated, no trailing path. Used for BOTH CORS and WebSocket Origin checks.
# (CLIENT_URL is the older name for the same setting and still works; ALLOWED_ORIGINS wins if both are set.)
ALLOWED_ORIGINS=http://localhost:5173
NODE_ENV=development

# ---- Production example (set these in your hosting provider's dashboard, not in a committed file) ----
# NODE_ENV=production
# ALLOWED_ORIGINS=https://your-dropdrop.vercel.app,https://dropdrop.example.com
# TRUST_PROXY=1        # number of reverse proxies YOU trust in front of the app (true = 1). Usually 1 on a PaaS.
#                      # Leave unset/false when clients connect directly. Never set it higher than the real number
#                      # of proxies: X-Forwarded-For is client-controlled, and only the entries appended by your own
#                      # proxies are used (counted from the right).
# PORT is normally injected by the host.

# ---- Optional tuning (defaults are fine; see DEPLOYMENT.md sections 4 and 5) ----
# COLLAB_FLUSH_INTERVAL_MS=1000   # how often an active room is written to the database (250-10000; 2000-3000 saves
#                                 # database writes on a free cluster but widens the crash data-loss window)
# STORAGE_GUARD=on                # refuse NEW rooms when the cluster is nearly full (never deletes anything)
# STORAGE_LIMIT_MB=512            # storage limit of your cluster tier
# STORAGE_GUARD_THRESHOLD=0.8     # refuse new rooms at this fraction of the limit (0.5-0.95)
# STORAGE_OTHER_DB_RESERVE_MB=0   # MB used by OTHER databases on the cluster; only needed if the database user cannot list databases

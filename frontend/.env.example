# Copy to .env.local for development (optional: the development defaults below apply if unset).
# In PRODUCTION these are REQUIRED build-time variables (set them in Vercel -> Project Settings -> Environment
# Variables, then redeploy). Only public URLs belong here; never secrets.

# REST API of the DropDrop backend
VITE_API_URL=http://localhost:5000
# WebSocket server of the DropDrop backend (a trailing /ws is added if missing)
VITE_WS_URL=ws://localhost:5000
# Public URL of this website; used when copying/sharing room links
VITE_PUBLIC_APP_URL=http://localhost:5173

# Production example:
# VITE_API_URL=https://api.your-domain.com
# VITE_WS_URL=wss://api.your-domain.com
# VITE_PUBLIC_APP_URL=https://your-dropdrop.vercel.app

# Optional, testing only: how long (ms, 5000-300000) the site waits for a sleeping server before giving up. Default 90000.
# VITE_WAKE_TIMEOUT_MS=90000
